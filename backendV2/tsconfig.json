{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@root/*": ["./*"],
      "@src/*": ["src/*"],
      "@modules/*": ["src/modules/*"]
    },
    "rootDir": "./src" // Thêm dòng này
  },
  "include": ["src/**/*"], // Đảm bảo bao gồm tất cả file trong src
  "exclude": ["node_modules", "dist"]
}
